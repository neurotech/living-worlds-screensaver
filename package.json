{
  "name": "living-worlds-screensaver",
  "version": "1.0.0",
  "description": "Living Worlds screensaver in Electron",
  "main": "app.js",
  "scripts": {
    "bundle": "electron-builder",
    "postbundle": "rm -rf ./dist/win-unpacked",
    "start": "electron ."
  },
  "build": {
    "directories": {
      "output": "./dist"
    },
    "win": {
      "target": "portable"
    },
    "artifactName" : "${productName}.scr"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neurotech/living-worlds-screensaver.git"
  },
  "author": "Tim Douglas",
  "license": "MIT",
  "dependencies": {
    "normalize.css": "^8.0.1"
  },
  "devDependencies": {
    "electron": "^6.0.1",
    "electron-builder": "^21.2.0"
  }
}
